{
  "name": "aegispy",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier -c .",
    "format": "prettier -w .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "component:build": "node scripts/component/build.mjs",
    "wit:codegen": "node scripts/wit/codegen.mjs",
    "engine:build": "node scripts/engine/build-all.mjs",
    "engine:verify": "node scripts/engine/verify.mjs",
    "selftest": "node scripts/selftest.mjs",
    "release:claims": "bash scripts/release_claims_check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.3",
    "eslint": "^10.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  }
}
