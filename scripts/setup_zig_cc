#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TOOLS_DIR="$ROOT_DIR/.tools/zig"
ZIG_VERSION="0.13.0"
ZIG_ARCHIVE_NAME="zig-linux-x86_64-$ZIG_VERSION"
ZIG_ARCHIVE_PATH="$TOOLS_DIR/zig.tar.xz"
ZIG_EXTRACTED_DIR="$TOOLS_DIR/$ZIG_ARCHIVE_NAME"
CC_WRAPPER="$TOOLS_DIR/cc"
CXX_WRAPPER="$TOOLS_DIR/cxx"

mkdir -p "$TOOLS_DIR"

if [ ! -x "$ZIG_EXTRACTED_DIR/zig" ]; then
  curl -L "https://ziglang.org/download/$ZIG_VERSION/$ZIG_ARCHIVE_NAME.tar.xz" -o "$ZIG_ARCHIVE_PATH"
  tar -xf "$ZIG_ARCHIVE_PATH" -C "$TOOLS_DIR"
fi

cat > "$CC_WRAPPER" <<SCRIPT
#!/usr/bin/env bash
set -euo pipefail

map_target() {
  case "\$1" in
    x86_64-unknown-linux-gnu) echo "x86_64-linux-gnu" ;;
    aarch64-unknown-linux-gnu) echo "aarch64-linux-gnu" ;;
    *) echo "\$1" ;;
  esac
}

args=()
while [ "\$#" -gt 0 ]; do
  case "\$1" in
    --target=*)
      target="\${1#--target=}"
      args+=("--target=\$(map_target "\$target")")
      shift
      ;;
    --target)
      shift
      if [ "\$#" -eq 0 ]; then
        break
      fi
      args+=("--target" "\$(map_target "\$1")")
      shift
      ;;
    *)
      args+=("\$1")
      shift
      ;;
  esac
done

exec "$ZIG_EXTRACTED_DIR/zig" cc "\${args[@]}"
SCRIPT
chmod +x "$CC_WRAPPER"

cat > "$CXX_WRAPPER" <<SCRIPT
#!/usr/bin/env bash
set -euo pipefail

map_target() {
  case "\$1" in
    x86_64-unknown-linux-gnu) echo "x86_64-linux-gnu" ;;
    aarch64-unknown-linux-gnu) echo "aarch64-linux-gnu" ;;
    *) echo "\$1" ;;
  esac
}

args=()
while [ "\$#" -gt 0 ]; do
  case "\$1" in
    --target=*)
      target="\${1#--target=}"
      args+=("--target=\$(map_target "\$target")")
      shift
      ;;
    --target)
      shift
      if [ "\$#" -eq 0 ]; then
        break
      fi
      args+=("--target" "\$(map_target "\$1")")
      shift
      ;;
    *)
      args+=("\$1")
      shift
      ;;
  esac
done

exec "$ZIG_EXTRACTED_DIR/zig" c++ "\${args[@]}"
SCRIPT
chmod +x "$CXX_WRAPPER"

echo "$CC_WRAPPER"
